# Copy this file to .env in the backend directory and set values for your setup.

# Database connection. This matches the default SQLite database location.
DATABASE_URL=sqlite:///./travel_agency.db

# Required in deployed environments. Generate with: openssl rand -hex 32
# Must be at least 32 bytes. Keep this value private and stable between restarts.
AUTH_SECRET_KEY=replace_with_output_of_openssl_rand_hex_32

# JWT token lifetimes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Set true when serving over HTTPS. SameSite must be lax, strict, or none.
# SameSite=none requires AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Base URL used to construct employee activation links.
ACTIVATION_URL_BASE=http://localhost:5173/activate
